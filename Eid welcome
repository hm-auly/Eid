<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ঈদ মোবারক - Shahzadi</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,500;1,400&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: #0a0a12;
  display: flex;
  justify-content: center;
  padding: 24px 16px 32px;
  min-height: 100vh;
}

.card {
  position: relative;
  width: 100%;
  max-width: 620px;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 0 60px rgba(180,100,200,0.18), 0 0 120px rgba(100,60,160,0.12), 0 20px 60px rgba(0,0,0,0.7);
}

.bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 10%, rgba(120,40,160,0.55) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 5%, rgba(60,20,120,0.5) 0%, transparent 45%),
    radial-gradient(ellipse at 50% 50%, rgba(30,10,70,0.8) 0%, transparent 70%),
    radial-gradient(ellipse at 10% 80%, rgba(100,20,140,0.35) 0%, transparent 45%),
    radial-gradient(ellipse at 90% 90%, rgba(40,10,90,0.4) 0%, transparent 40%),
    linear-gradient(160deg, #12003a 0%, #1a0040 30%, #0d0025 60%, #180035 100%);
  z-index: 0;
}

.stars { position: absolute; inset: 0; z-index: 1; overflow: hidden; }
.star {
  position: absolute;
  background: #fff;
  border-radius: 50%;
  animation: twinkle var(--d, 3s) ease-in-out infinite var(--delay, 0s);
}
@keyframes twinkle {
  0%,100% { opacity: var(--opa, 0.6); transform: scale(1); }
  50% { opacity: 0.1; transform: scale(0.6); }
}

.moon-glow {
  position: absolute;
  top: -30px; right: -30px;
  width: 200px; height: 200px;
  background: radial-gradient(circle, rgba(255,230,120,0.18) 0%, rgba(255,200,80,0.08) 40%, transparent 70%);
  z-index: 1;
  border-radius: 50%;
}

.geo-top { position: absolute; top: 0; left: 0; right: 0; height: 90px; z-index: 2; overflow: hidden; }
.geo-bottom { position: absolute; bottom: 0; left: 0; right: 0; height: 90px; z-index: 2; overflow: hidden; }

.content { position: relative; z-index: 3; padding: 80px 44px 80px; }

.top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
.moon-icon { font-size: 32px; filter: drop-shadow(0 0 12px rgba(255,220,80,0.8)); }
.date-text { font-family: 'Cormorant Garamond', serif; font-size: 14px; color: rgba(255,220,160,0.8); letter-spacing: 1.5px; font-style: italic; }

.letter-title { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #f0d0ff; text-align: center; margin-bottom: 32px; letter-spacing: 0.5px; text-shadow: 0 0 20px rgba(200,100,255,0.5); }

.divider { display: flex; align-items: center; gap: 10px; margin: 22px 0; }
.div-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(200,130,255,0.5), transparent); }
.div-icon { font-size: 14px; color: rgba(220,160,255,0.7); }

.para { font-family: 'Hind Siliguri', sans-serif; font-size: 15.5px; font-weight: 400; color: rgba(235,215,255,0.88); line-height: 1.95; margin-bottom: 4px; letter-spacing: 0.2px; }
.para.bold { font-weight: 600; color: #f0d8ff; font-size: 16px; }
.para.italic-verse { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 16.5px; color: rgba(220,190,255,0.9); text-align: center; margin: 6px 0; }

.closing-box { margin-top: 36px; border: 1px solid rgba(200,140,255,0.35); border-radius: 14px; padding: 22px 28px; background: rgba(100,30,160,0.18); text-align: center; backdrop-filter: blur(4px); box-shadow: inset 0 0 30px rgba(150,60,220,0.08), 0 0 20px rgba(150,60,220,0.1); }
.closing-main { font-family: 'Hind Siliguri', sans-serif; font-size: 20px; font-weight: 600; color: #f4d4ff; letter-spacing: 0.5px; margin-bottom: 10px; text-shadow: 0 0 16px rgba(200,100,255,0.4); }
.closing-eng { font-family: 'Playfair Display', serif; font-style: italic; font-size: 16px; color: rgba(255,200,230,0.85); letter-spacing: 0.5px; line-height: 1.7; }
.closing-hearts { margin-top: 12px; font-size: 18px; letter-spacing: 4px; filter: drop-shadow(0 0 6px rgba(255,100,150,0.5)); }

.particles { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
.particle { position: absolute; border-radius: 50%; animation: float var(--d,6s) ease-in-out infinite var(--delay,0s); opacity: 0; }
@keyframes float {
  0% { opacity:0; transform: translateY(0) scale(0.5); }
  20% { opacity: var(--opa,0.4); }
  80% { opacity: var(--opa,0.4); }
  100% { opacity:0; transform: translateY(-60px) scale(1); }
}
</style>
</head>
<body>
<div class="card">
  <div class="bg"></div>
  <div class="stars" id="stars"></div>
  <div class="moon-glow"></div>
  <div class="particles" id="particles"></div>

  <div class="geo-top">
    <svg width="100%" height="90" viewBox="0 0 620 90" preserveAspectRatio="none">
      <defs>
        <linearGradient id="geoGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="rgba(180,80,255,0)"/>
          <stop offset="50%" stop-color="rgba(180,80,255,0.35)"/>
          <stop offset="100%" stop-color="rgba(180,80,255,0)"/>
        </linearGradient>
      </defs>
      <path d="M0,90 L0,40 Q60,0 120,40 Q180,80 240,40 Q300,0 360,40 Q420,80 480,40 Q540,0 620,40 L620,90 Z" fill="rgba(100,20,160,0.15)" stroke="url(#geoGrad)" stroke-width="0.8"/>
      <path d="M0,90 L0,55 Q60,20 120,55 Q180,90 240,55 Q300,20 360,55 Q420,90 480,55 Q540,20 620,55 L620,90 Z" fill="rgba(80,10,140,0.1)"/>
      <g fill="rgba(220,160,255,0.5)">
        <polygon points="310,8 316,14 310,20 304,14"/>
        <polygon points="155,22 159,26 155,30 151,26"/>
        <polygon points="465,22 469,26 465,30 461,26"/>
        <polygon points="62,32 65,35 62,38 59,35"/>
        <polygon points="558,32 561,35 558,38 555,35"/>
      </g>
    </svg>
  </div>

  <div class="content">
    <div class="top-row">
      <span class="moon-icon">🌙</span>
      <span class="date-text">ঈদুল ফিতর, ২০২৬</span>
      <span class="moon-icon" style="font-size:22px">✨</span>
    </div>

    <div class="letter-title">আমার সবচেয়ে প্রিয় মানুষকে… 💫</div>

    <div class="divider"><div class="div-line"></div><span class="div-icon">🌸</span><div class="div-line"></div></div>

    <p class="para">"ঈদ মোবারক" — মাত্র দুটো শব্দ,</p>
    <p class="para">কিন্তু তোমার জন্য বুকের ভেতর যা জমে আছে,</p>
    <p class="para">তা দুটো শব্দে ধরার সাধ্য নেই আমার… 🌸</p>

    <br>
    <p class="para">কারণ তুমি শুধু আমার জীবনের একজন মানুষ না —</p>
    <p class="para">তুমি সেই আলো, যেটা না থাকলে</p>
    <p class="para">আমার প্রতিটা দিন কেমন যেন ফিকে হয়ে যায়… 💫</p>

    <div class="divider"><div class="div-line"></div><span class="div-icon">🌺</span><div class="div-line"></div></div>

    <p class="para">তুমি জানো, ঈদের সকালে যখন আকাশটা</p>
    <p class="para">একটু বেশি নীল লাগে, বাতাসে একটু বেশি</p>
    <p class="para">সুবাস থাকে — আমার মন তোমার কথাই ভাবে সবার আগে। 💞</p>
    <br>
    <p class="para">তোমার হাসিটা মনে পড়ে —</p>
    <p class="para">সেই হাসি, যেটা দেখলে মনে হয়</p>
    <p class="para">পৃথিবীর সব ক্লান্তি মিলিয়ে যায়… 🌷</p>

    <div class="divider"><div class="div-line"></div><span class="div-icon">💌</span><div class="div-line"></div></div>

    <p class="para">জানো, ঈদ মানে নতুন জামা, সেমাই, আনন্দ —</p>
    <p class="para">সবই আছে, সবই সুন্দর। কিন্তু আমার কাছে</p>
    <p class="para bold">ঈদের সবচেয়ে বড় উপহার — তুমি। 🫶</p>
    <br>
    <p class="para">শুধু তুমি আছো বলেই প্রতিটা দিন</p>
    <p class="para">উৎসবের মতো লাগে… 🌹</p>

    <div class="divider"><div class="div-line"></div><span class="div-icon">🕊️</span><div class="div-line"></div></div>

    <p class="para">আমার একটাই দোয়া — আল্লাহ তোমার জীবনটা</p>
    <p class="para">ভরিয়ে দিক ভালোবাসায়, শান্তিতে আর হাসিতে। ✨</p>
    <br>
    <p class="para">তোমার চোখে যেন কখনো জল না আসে,</p>
    <p class="para">আর যদি আসেও — সেই জল মুছে দেওয়ার</p>
    <p class="para">জন্য আমি যেন পাশে থাকি… 💘</p>

    <br>
    <p class="para italic-verse">"এই মানুষটাকে পেয়েছি বলেই জীবনটা এত সুন্দর…" 🌙</p>

    <div class="closing-box">
      <div class="closing-main">🌙 ঈদ মোবারক আমার মায়াবতী 💖</div>
      <div class="closing-eng">I Love you shahzadi 👑</div>
      <div class="closing-hearts">🌹 ❤️ 🌹</div>
    </div>
  </div>

  <div class="geo-bottom">
    <svg width="100%" height="90" viewBox="0 0 620 90" preserveAspectRatio="none">
      <defs>
        <linearGradient id="geoGrad2" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="rgba(180,80,255,0)"/>
          <stop offset="50%" stop-color="rgba(180,80,255,0.35)"/>
          <stop offset="100%" stop-color="rgba(180,80,255,0)"/>
        </linearGradient>
      </defs>
      <path d="M0,0 L0,50 Q60,90 120,50 Q180,10 240,50 Q300,90 360,50 Q420,10 480,50 Q540,90 620,50 L620,0 Z" fill="rgba(100,20,160,0.15)" stroke="url(#geoGrad2)" stroke-width="0.8"/>
      <path d="M0,0 L0,35 Q60,70 120,35 Q180,0 240,35 Q300,70 360,35 Q420,0 480,35 Q540,70 620,35 L620,0 Z" fill="rgba(80,10,140,0.1)"/>
      <g fill="rgba(220,160,255,0.5)">
        <polygon points="310,82 316,76 310,70 304,76"/>
        <polygon points="155,68 159,64 155,60 151,64"/>
        <polygon points="465,68 469,64 465,60 461,64"/>
      </g>
    </svg>
  </div>
</div>

<script>
const starsEl = document.getElementById('stars');
for (let i = 0; i < 80; i++) {
  const s = document.createElement('div');
  s.className = 'star';
  const size = Math.random() * 2.5 + 0.5;
  s.style.cssText = `width:${size}px;height:${size}px;top:${Math.random()*100}%;left:${Math.random()*100}%;--d:${2+Math.random()*4}s;--delay:${Math.random()*4}s;--opa:${0.3+Math.random()*0.7};`;
  starsEl.appendChild(s);
}
const pEl = document.getElementById('particles');
const pColors = ['rgba(255,180,220,0.5)','rgba(200,140,255,0.5)','rgba(255,220,120,0.4)','rgba(160,100,255,0.4)'];
for (let i = 0; i < 18; i++) {
  const p = document.createElement('div');
  p.className = 'particle';
  const size = Math.random()*4+2;
  p.style.cssText = `width:${size}px;height:${size}px;background:${pColors[Math.floor(Math.random()*pColors.length)]};left:${10+Math.random()*80}%;top:${20+Math.random()*60}%;--d:${5+Math.random()*6}s;--delay:${Math.random()*6}s;--opa:${0.3+Math.random()*0.4};`;
  pEl.appendChild(p);
}
</script>
</body>
</html>
